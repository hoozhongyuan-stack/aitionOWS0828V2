# ============================================================
# AitionOWS 环境变量样例
# 复制为 .env(本地开发)或在 docker-compose 中注入(生产)
# 注意:业务级配置(主题/品牌/微信凭证等)一律走后台入库,
#      这里只放"启动必需的基础设施级"变量。
# ============================================================

# 服务端口
PORT=3000

# 数据库连接(SQLite 本地文件)
# 注意:Prisma 对 SQLite 相对路径以 prisma/schema.prisma 所在目录为基准,
#      因此 ../data/app.db 实际指向 <项目根>/data/app.db(与 Docker volume 挂载一致)
DATABASE_URL="file:../data/app.db"

# JWT 签名密钥(生产务必替换为强随机串,可用: openssl rand -base64 48)
AUTH_SECRET="please-change-me-to-a-long-random-secret"

# 本地存储目录(相对项目根;Docker 中挂载为 volume)
UPLOAD_DIR="./uploads"
BACKUP_DIR="./backups"

# 站点基础 URL(用于 sitemap / 分享链接绝对地址)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# 微信登录兜底(通常留空,由后台可视化配置;此处仅作首次初始化默认值)
# WECHAT_APP_ID=
# WECHAT_APP_SECRET=
