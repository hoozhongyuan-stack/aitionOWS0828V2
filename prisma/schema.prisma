// ============================================================
// AitionOWS 数据模型 — SQLite + Prisma
// 设计依据:docs/架构设计文档.md 第 3 节
// 说明:内容型实体用独立 *Translation 表存多语言;
//      配置类走 Setting(group,key,value=JSON) 通用存储。
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ------------------- 状态值约定(重要) -------------------
// SQLite 连接器不支持 Prisma enum,以下字段用 String 存储,
// 合法值由 src/types/domain.ts 常量 + zod 在应用层强约束:
//   Content.status : DRAFT | PUBLISHED | OFFLINE | SCHEDULED | PENDING | REJECTED
//   Content.source : ADMIN | UGC
//   Comment.status : PENDING | APPROVED | REJECTED
//   User.status    : ACTIVE | DISABLED
//   Like/ShareLog.targetType : CONTENT
//   Favorite.targetType : CONTENT
//   Agreement.type : REGISTER | PRIVACY

// ------------------- 配置与站点基础 -------------------

/// 通用配置存储:主题色/字体/品牌/GEO/功能开关/维护模式/微信凭证/文件限制等全部入库
model Setting {
  id        Int      @id @default(autoincrement())
  group     String // 分组:theme / brand / seo / features / wechat / upload / i18n ...
  key       String // 配置键
  value     String // 值(JSON 字符串,支持任意结构)
  updatedAt DateTime @updatedAt

  @@unique([group, key])
  @@index([group])
}

/// 语言配置:后台勾选默认语言与前台启用语言
model Locale {
  code      String  @id // zh-CN / en ...
  name      String // 显示名
  isDefault Boolean @default(false)
  enabled   Boolean @default(true)
  sort      Int     @default(0)
}

/// 静态 UI 文案覆盖(DB 优先,messages/*.json 兜底)
model UiTranslation {
  id        Int    @id @default(autoincrement())
  locale    String
  namespace String // 命名空间(如 common / nav / form)
  key       String
  value     String

  @@unique([locale, namespace, key])
  @@index([locale])
}

/// 用户协议(注册协议/隐私政策),按语言富文本存储
model Agreement {
  id        Int      @id @default(autoincrement())
  type      String // REGISTER(注册协议)/ PRIVACY(隐私政策)
  locale    String
  title     String
  body      String // 富文本 HTML
  updatedAt DateTime @updatedAt

  @@unique([type, locale])
}

// ------------------------- SEO / GEO -------------------------

/// 固定页面 TDK(首页/联系页等无独立实体的页面)
model SeoMeta {
  id          Int    @id @default(autoincrement())
  pageKey     String // home / contact / login ...
  locale      String
  title       String
  keywords    String
  description String

  @@unique([pageKey, locale])
}

// ------------------- CMS:栏目 / 导航 / 内容 -------------------

/// 栏目(内容分类,同时是导航来源之一);支持树形、排序、隐藏、自定义模块类型
model Category {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  parentId    Int? // 父栏目(树形)
  moduleType  String // 模块类型:news/product/case/article...
  sort        Int      @default(0)
  visible     Boolean  @default(true)
  externalUrl String? // 自定义跳转链接(可选)
  allowSubmit Boolean  @default(false) // 是否允许用户投稿到本栏目
  createdAt   DateTime @default(now())

  parent       Category?             @relation("CategoryTree", fields: [parentId], references: [id])
  children     Category[]            @relation("CategoryTree")
  translations CategoryTranslation[]
  contents     Content[]
}

model CategoryTranslation {
  id          Int     @id @default(autoincrement())
  categoryId  Int
  locale      String
  name        String // 栏目名(多语言)
  description String?

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
}

/// 导航菜单项(可与栏目关联,也可自定义外链)
model NavItem {
  id         Int     @id @default(autoincrement())
  parentId   Int?
  categoryId Int? // 关联栏目(可空)
  label      String // 兜底文案
  labelI18n  String? // JSON: { "zh-CN":"...", "en":"..." }
  url        String? // 自定义链接(与 categoryId 二选一)
  sort       Int     @default(0)
  visible    Boolean @default(true)
  target     String  @default("_self")
}

/// 首页顶部通屏轮播图(新增需求①):后台最多维护 5 张,导航栏叠加在其上作为背景
model Banner {
  id        Int      @id @default(autoincrement())
  imageUrl  String
  linkUrl   String? // 点击跳转(可选)
  sort      Int      @default(0)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
}

/// 内容主表:后台发布内容与用户投稿共用(source 区分),含互动统计计数
model Content {
  id           Int       @id @default(autoincrement())
  slug         String    @unique
  categoryId   Int
  status       String    @default("DRAFT") // DRAFT/PUBLISHED/OFFLINE/SCHEDULED/PENDING/REJECTED
  source       String    @default("ADMIN") // ADMIN(后台)/ UGC(用户投稿)
  coverUrl     String? // 封面图 URL(/uploads/...,资产已在 MediaAsset 登记)
  gallery      String? // 图集:JSON 数组(图片路径有序列表),product 类栏目的商品多图
  specs        String? // 规格参数:JSON 数组([{k,v}...] 有序键值对,与服务层 parseSpecs 序列化格式一致),product 类栏目的商品参数
  authorUserId Int? // UGC 投稿人(前台用户)
  authorName   String? // 作者显示名:后台发布时单独设置(必填);UGC 投稿自动取投稿人昵称
  formId       Int? // 关联表单(可选):非空且表单启用时,文章详情页底部渲染该表单;无外键,应用层维护一致性
  publishAt    DateTime? // 定时发布时间
  // —— 交易字段(V4.0):priceCents 整数"分"存;null=不展示价格,仅询盘(混合模式)——
  priceCents   Int? // 价格(最小货币单位);商品类型栏目使用
  currency     String? // ISO 4217(USD/EUR…);null=用站点默认币种(Setting group=shop)
  spu          String? // 商品货号(V4.0.2,自由文本选填);下单时快照进 OrderItem
  // —— 互动统计计数:真实值,只读(后台无写接口,见 api/admin/contents 注释)——
  viewCount    Int       @default(0)
  likeCount    Int       @default(0)
  shareCount   Int       @default(0)
  favoriteCount Int      @default(0) // 收藏数:随 Favorite 表增删由应用层同步维护
  // —— 拟真互动数据(V4.8.0):只影响前台展示值,绝不改写上面三列 ——
  statsMode    String    @default("AUTO") // AUTO=跟随全局 | OFF=此篇不拟真 | CUSTOM=用 statsBase
  statsBase    Int? // CUSTOM 模式的 30 天累计阅读基数
  statsSalt    String? // 单篇种子盐:后台「重新随机」写入新值 → 该篇曲线重掷
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  category     Category             @relation(fields: [categoryId], references: [id])
  translations ContentTranslation[]
  comments     Comment[]
  dailyViews   ContentDailyView[]

  @@index([categoryId, status])
  @@index([status, publishAt])
}

/// 内容多语言正文 + 单页独立 TDK
model ContentTranslation {
  id          Int     @id @default(autoincrement())
  contentId   Int
  locale      String
  title       String
  summary     String?
  body        String // 富文本 HTML(图文/视频/表格/链接/列表)
  // —— 单页 TDK ——
  seoTitle    String?
  seoKeywords String?
  seoDesc     String?
  // 规格参数(V3.1 REQ-001):JSON 数组([{k,v}...],格式与 Content.specs 一致),
  // 按语言独立维护;详情页兜底链=当前语言 translation.specs → Content.specs → 空表。
  // 迁移 20260903000000_v31_translation_specs 已把存量行回填为对应 Content.specs 的副本
  // (主表无 specs 则 NULL);编辑器按语言 Tab 全量往返,顶层 Content.specs 仍作兜底列。
  specs       String?

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([contentId, locale])
  @@index([locale])
}

// ------------------------- 表单获客 -------------------------

/// 表单定义:字段结构以 JSON 存(可视化构建器输出),可关联栏目/页面
/// 订单(V4.0):线下付款+后台审核流。金额快照模式(下单时锁定),状态机
/// PENDING→CONFIRMED→SHIPPED→COMPLETED,任意非终态可 CANCELLED。
model Order {
  id              Int       @id @default(autoincrement())
  no              String    @unique // 订单号 AO-YYYYMMDD-XXXX
  status          String    @default("PENDING") // PENDING/CONFIRMED/SHIPPED/COMPLETED/CANCELLED/REFUNDED(V4.2)
  userId          Int? // 登录用户关联;游客下单为 null
  email           String
  name            String
  phone           String?
  country         String
  address         String
  city            String
  zip             String?
  note            String? // 买家备注
  currency        String
  itemsTotalCents Int // 商品小计(快照重算)
  shippingCents   Int       @default(0) // 运费(站点级设置:固定运费/免邮门槛)
  grandTotalCents Int // 应付总额
  adminNote       String? // 管理员备注(发货备注/取消原因/内部记录)
  shippingCarrier  String? // 物流公司(V4.0.1,发货时登记,非必填)
  trackingNumber   String? // 物流编号(V4.0.1,发货时登记,非必填)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  confirmedAt     DateTime?
  shippedAt       DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?
  refundedAt      DateTime? // 售后退款完成时间(V4.2)

  items     OrderItem[]
  refund    OrderRefund?

  @@index([status, createdAt])
  @@index([email])
}

/// 订单售后(V4.2):仅退款;一单一次申请(unique orderId);审核通过填退款金额
model OrderRefund {
  id                Int      @id @default(autoincrement())
  orderId           Int      @unique
  reason            String // 用户填写的售后原因
  status            String   @default("PENDING") // PENDING/APPROVED/REJECTED
  refundAmountCents Int? // 审核通过时填写(≤订单实付)
  adminNote         String? // 审核备注(通过:说明;拒绝:原因)
  createdAt         DateTime @default(now())
  reviewedAt        DateTime?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

/// 订单条目(V4.0):下单快照(title/price);contentId 无外键,内容删除后快照保留
model OrderItem {
  id                 Int     @id @default(autoincrement())
  orderId            Int
  contentId          Int
  titleSnapshot      String
  priceCentsSnapshot Int
  currency           String
  qty                Int
  spu                String? // SPU 快照(V4.0.2)
  coverUrl           String? // 封面快照(V4.0.2,订单明细缩略图)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Form {
  id            Int      @id @default(autoincrement())
  name          String
  slug          String   @unique
  schema        String // JSON:字段数组(类型/字段名/必填/提示/校验规则)
  relatedKey    String? // 关联页面/栏目标识(场景化获客)
  antiDuplicate Boolean  @default(true) // 防重复提交开关
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now())

  submissions FormSubmission[]
}

/// 表单提交数据:答案以 JSON 存,记录来源用于防刷/防重复
model FormSubmission {
  id          Int      @id @default(autoincrement())
  formId      Int
  data        String // JSON:字段名 -> 值
  ip          String?
  userAgent   String?
  fingerprint String? // 防重复指纹(ip+表单+关键字段哈希)
  status      String   @default("UNHANDLED") // UNHANDLED(未处理)/HANDLED(已处理)
  handledAt   DateTime? // 标记处理时间
  createdAt   DateTime @default(now())

  form Form @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId, createdAt])
  @@index([fingerprint])
}

// ------------------- 用户与管理员 -------------------

/// 前台注册用户(邮箱 / 微信)
model User {
  id            Int        @id @default(autoincrement())
  email         String?    @unique
  passwordHash  String? // 邮箱注册者有,纯微信登录者可空
  nickname      String?
  avatarUrl     String?
  wechatOpenId  String?  @unique // 微信 openid
  wechatUnionId String?  @unique // 微信 unionid(可选)
  // —— 公司/地区资料(后台用户管理维护,全部可空)——
  companyName   String? // 公司名称(支持后台列表模糊搜索)
  country       String? // 国家
  province      String? // 省/州
  city          String? // 市
  status        String   @default("ACTIVE") // ACTIVE / DISABLED
  createdAt     DateTime @default(now())

  comments Comment[]
}

/// 后台管理员(与前台用户隔离,安全边界清晰)
/// 后台管理员(V4.1):OWNER 主账号全部权限;STAFF 子账号按预定义权限组(permissions)受限
model AdminUser {
  id           Int       @id @default(autoincrement())
  username     String    @unique
  passwordHash String
  displayName  String?
  role         String    @default("OWNER") // OWNER/STAFF
  status       String    @default("ACTIVE") // ACTIVE/DISABLED(子账号禁用,登录与会话校验即失效)
  permissions  String? // JSON 数组文本(["content","commerce","moderation","geo"]);OWNER 忽略
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
}

/// 后台操作日志(V4.1):敏感写操作审计,只增不改
model AdminLog {
  id        Int      @id @default(autoincrement())
  adminId   Int? // 登录失败等场景可为空
  adminName String // 显示名快照
  action    String // 动作标识(如 content.delete / settings.update / auth.login)
  target    String? // 对象标识(如 content:12 / settings:theme)
  detail    String? // 详情摘要
  ip        String?
  createdAt DateTime @default(now())

  @@index([adminId, createdAt])
  @@index([createdAt])
}

/// 密码重置令牌(忘记密码邮件链接):只存哈希,一次性,30 分钟过期
model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ------------- UGC:评论 / 点赞 / 转发 / 敏感词 -------------

/// 评论:默认待审核,审核通过前台可见。
/// commentLoginRequired 开关关闭时允许游客评论(userId 为空,guestName 展示)。
model Comment {
  id        Int      @id @default(autoincrement())
  contentId Int
  userId    Int? // 登录用户;游客评论为空
  guestName String? // 游客昵称(游客评论时使用);作者回复时存站点名
  body      String
  status    String   @default("PENDING") // PENDING / APPROVED / REJECTED
  // —— 两层回复(V4.7.4):后台回复指向被回复的评论;访客评论恒为顶层(null)——
  parentId      Int?
  isAuthorReply Boolean @default(false) // 作者回复:前台带「作者」徽标

  ip        String?
  createdAt DateTime @default(now())

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id])
  parent  Comment? @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("CommentThread")

  @@index([contentId, status])
  @@index([status])
  @@index([parentId])
}

/// 点赞记录:用于去重/防刷(登录用 userId,游客用 guestKey 指纹)
model Like {
  id         Int      @id @default(autoincrement())
  targetType String   @default("CONTENT") // 互动目标类型(可扩展)
  targetId   Int
  userId     Int? // 登录用户
  guestKey   String? // 游客指纹(ip+ua 哈希 / cookie id)
  createdAt  DateTime @default(now())

  @@unique([targetType, targetId, userId])
  @@unique([targetType, targetId, guestKey])
  @@index([targetType, targetId])
}

/// 收藏记录:登录用户对已发布内容的收藏(targetId 通用引用,不建 Prisma relation,
/// 与 Content.formId 同策略:无外键,应用层维护一致性);
/// 唯一约束兜底防重复,增删时由应用层同步 Content.favoriteCount。
model Favorite {
  id         Int      @id @default(autoincrement())
  targetType String   @default("CONTENT") // 收藏目标类型(可扩展)
  targetId   Int // 收藏目标 id(通用引用,无外键,应用层维护一致性)
  userId     Int // 收藏人(仅登录用户)
  createdAt  DateTime @default(now())

  @@unique([targetType, targetId, userId])
  @@index([userId])
}

/// 转发日志(主要用于统计;计数已冗余在 Content.shareCount)
model ShareLog {
  id         Int      @id @default(autoincrement())
  targetType String   @default("CONTENT") // 互动目标类型(可扩展)
  targetId   Int
  ip         String?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
}

/// 敏感词库:评论/投稿基础过滤
model SensitiveWord {
  id        Int      @id @default(autoincrement())
  word      String   @unique
  createdAt DateTime @default(now())
}

// ------------------- GEO 监测(V3.2) -------------------

/// AI 爬虫统计:引擎×日期×路径 计数(upsert 累加;白名单见 server/geo)
model AICrawlStat {
  id    Int    @id @default(autoincrement())
  bot   String
  date  String // YYYY-MM-DD(服务器时区)
  path  String
  count Int    @default(1)
  kind  String @default("ai") // ai | search | suspected(V4.6.4 口径分区)

  @@unique([bot, date, path])
  @@index([date, bot])
}

/// AI 爬虫事件明细:秒级时间戳,保留 180 天(清理见 server/geo)
model AICrawlEvent {
  id   Int      @id @default(autoincrement())
  bot  String
  path String
  ua   String?
  kind String   @default("ai") // ai | search | suspected(V4.6.4)
  ts   DateTime @default(now())

  @@index([bot, ts])
  @@index([ts])
}

/// AI 渠道引荐事件明细:渠道×落地页×秒级时间
model AIReferralEvent {
  id      Int      @id @default(autoincrement())
  source  String
  landing String
  kind    String   @default("ai") // ai | search(V4.6.4)
  ts      DateTime @default(now())

  @@index([source, ts])
  @@index([ts])
}

/// AI 渠道引荐统计:来源×落地页×日期 计数(referer 白名单命中)
model AIReferralStat {
  id       Int    @id @default(autoincrement())
  source   String // 来源域名(AI 渠道 或 传统搜索引擎;V4.6.4 起含后者)
  landing  String // 落地页路径
  date     String
  count    Int    @default(1)
  visitors Int    @default(1)
  kind     String @default("ai") // ai | search(V4.6.4 口径分区)

  @@unique([source, landing, date])
  @@index([date, source])
}

// ------------------------- 文件 / 媒体 -------------------------

/// 本地文件资产:统一登记,便于文件管理与 alt 语义
/// 媒体文件夹(V4.2):二级(parentId 仅 null 或一级 id,应用层禁第三级)
model MediaFolder {
  id        Int      @id @default(autoincrement())
  name      String
  parentId  Int? // null=一级
  sort      Int      @default(0)
  createdAt DateTime @default(now())
}

model MediaAsset {
  id           Int      @id @default(autoincrement())
  path         String // 相对 uploads/ 的路径
  filename     String
  mime         String
  size         Int // 字节
  width        Int?
  height       Int?
  alt          String? // 图片 alt 语义(SEO)
  uploaderType String   @default("admin") // admin / user
  uploaderId   Int?
  folderId     Int? // 归属文件夹(V4.2);null=未分类
  createdAt    DateTime @default(now())

  @@index([mime])
}

// ------------------- 运维:统计 / 备份 -------------------

/// 轻量访问统计(按天+路径聚合,供看板)
model DailyStat {
  id   Int    @id @default(autoincrement())
  date String // YYYY-MM-DD
  path String @default("*") // '*' 为全站汇总
  pv   Int    @default(0)
  uv   Int    @default(0)

  @@unique([date, path])
  @@index([date])
}

/// 真实阅读逐日明细(V4.8.0):拟真放大要按"真实事件发生在哪天"分 5 天释放,
/// 故记到天粒度。只有发生过真实阅读的内容才会有行(通常极少),列表页批量查询代价可忽略。
model ContentDailyView {
  id        Int      @id @default(autoincrement())
  contentId Int
  date      String // 本地时区 YYYY-MM-DD
  views     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([contentId, date])
  @@index([contentId])
}

/// 备份记录:一键数据库 + 文件备份
model BackupRecord {
  id        Int      @id @default(autoincrement())
  type      String // db / files / full
  path      String // 备份文件位于 backups/
  size      Int
  createdAt DateTime @default(now())
}
